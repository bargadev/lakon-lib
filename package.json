{
  "name": "lakonai",
  "version": "1.2.7",
  "description": "lakonai — save AI context tokens. Filters & compresses CLI output (git, ls, grep, find, test runners, lint/build, docker/kubectl/aws) before it reaches Claude Code, Codex, Cursor, Windsurf, Cline or Gemini — and learns to filter new commands automatically the more you use it.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
    "cline",
    "gemini",
    "llm",
    "tokens",
    "token-savings",
    "context-window",
    "ai-coding",
    "agent",
    "cli",
    "output-filter",
    "test-runner",
    "eslint",
    "pytest"
  ],
  "license": "MIT",
  "author": "bargadev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bargadev/lakonai.git"
  },
  "bugs": {
    "url": "https://github.com/bargadev/lakonai/issues"
  },
  "type": "commonjs",
  "main": "src/filters/index.js",
  "bin": {
    "lakonai": "bin/lakonai.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern='(?<!integration|e2e-proxy|cli|bash-rewrite|grep-guard|learn-report-integration|mem-llm|session-start|stop-hook)\\.test\\.js$'",
    "test:integration": "jest --testPathPattern='(graph-integration|graph-parser|proxy-server|learn-report-integration|bash-rewrite|grep-guard|session-start|stop-hook)\\.test\\.js$'",
    "test:e2e": "jest --testPathPattern='(cli|e2e-proxy|integration)\\.test\\.js$'",
    "test:coverage": "jest --coverage",
    "test:coverage:check": "jest --coverage",
    "bench": "node -e \"process.stdout.write(require('./src/bench').format(require('./src/bench').runBench()))\""
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
